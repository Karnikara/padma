# Postgres DSN (required)
DATABASE_URL=postgres://padma:padma@localhost:5432/padma?sslmode=disable

# RPC of an external Fiber node you run (merchant flows call it). In the compose
# stack, use http://host.docker.internal:8227 to reach a node on your host.
FIBER_RPC_ENDPOINT=http://127.0.0.1:8227
# Optional bearer token for the node RPC.
FIBER_BISCUIT_TOKEN=

# Ingest source: fake | polling | pubsub. Only 'fake' is wired today
# (the real store_changes source is deferred in the kanaka library).
INGEST_SOURCE=fake
# Seed file replayed by the fake source.
SEED_FILE=/seed/changes.json

# Webhook dispatcher tuning.
WEBHOOK_MAX_ATTEMPTS=8
WEBHOOK_WORKERS=4

# API listen address.
HTTP_ADDR=:8080
